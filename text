import { Mesh, MeshStandardMaterial, Object3D, PointLight, PointLightHelper, PlaneGeometry, Euler, CameraHelper, DirectionalLight } from "three";
import { Reflector } from "three/examples/jsm/objects/Reflector";
import { Object3DId } from "../../constants/games/Object3DId";
import { ViewId } from "../../constants/views/ViewId";
import { ViewPlacementId } from "../../constants/views/ViewPlacementId";
import { Object3DsProxy } from "../../core/_engine/threejs/proxies/Object3DsProxy";
import { WithoutTransitionThreeView } from "../../core/_engine/threejs/views/WithoutTransitionThreeView";
import { ThreeAssetsManager } from "@cooker/three";
import { AssetId } from "../../constants/games/AssetId";
import { ThreeInteractive } from "../../core/_engine/threejs/interactives/ThreeInteractive";
import { Vector3 } from "yuka";
import { ThreeCameraControllerBase } from "../../core/_engine/threejs/cameras/bases/ThreeCameraControllerBase";
import gsap from "gsap";
import { ThreeCamerasProxy } from "../../core/_engine/threejs/proxies/ThreeCamerasProxy";
import Lenis from '@studio-freight/lenis';

export default class MainThreeView extends WithoutTransitionThreeView {
    private _scene: Object3D;
    private _light: PointLight;
    private _mirror: Reflector;
    private _intersection: IntersectionObserver;
    private _clickZoneInteractive: ThreeInteractive;
    private _cameraPositions: { position: Vector3; rotation: Euler; }[] = [];
    private _camera: ThreeCameraControllerBase;
    private _scrollProgress: number = 0;
    private _pauseScrollProgress: number | null = null; // Stocke la position où la pause est activée
    private _pauseThreshold: number = 0.01; // Seuil pour détecter un breakpoint
    private _scrollResumeThreshold: number = 0.1; // Scroll requis pour repartir
    private _resumeOffset: number = 0; // Permet de lisser la reprise
    private _lenis: Lenis;

    constructor() {
        super(ViewId.THREE_MAIN, ViewPlacementId.THREE_MAIN);

        this._scene = Object3DsProxy.GetObject3D(Object3DId.MAIN);
        this._camera = ThreeCamerasProxy.CamerasMap.get('MAIN');
        this._light = new PointLight(0xffffff, 2000, 0, 2.7);
        this._light.position.set(0, 5, 70);

        this._mirror = new Reflector(
            new PlaneGeometry(200, 200),
            {
                clipBias: 0.003,
                textureWidth: window.innerWidth * 2,
                textureHeight: window.innerHeight * 2,
                color: 0x777777,
            }
        );
        this._mirror.position.set(0, -15, 0);
        this._mirror.rotation.x = -Math.PI / 2;

        this._scene.traverse((child) => {
            if (child.name === Object3DId.PROJECTS) {
                for (let i = 0; i < child.children.length; i++) {
                    const mesh = child.children[i] as Mesh;
                    mesh.material = new MeshStandardMaterial({
                        map: ThreeAssetsManager.GetTexture(AssetId.IMAGE_ONE),
                        envMapIntensity: 0,
                    });
                }
            }
            if (child.name === Object3DId.SCREENS) {
                for (let i = 0; i < child.children.length; i++) {
                    const mesh = child.children[i] as Mesh;
                    mesh.material = new MeshStandardMaterial({
                        color: 0xeeeeee,
                        metalness: 0.9,
                        roughness: 0.8,
                        envMapIntensity: 0,
                    });
                }
            }
            if (child.name === Object3DId.CAMERAS_POS) {
                for (let i = 0; i < child.children.length; i++) {
                    const cam = child.children[i];
                    this._cameraPositions.push({
                        position: new Vector3(cam.position.x, cam.position.y, cam.position.z),
                        rotation: new Euler(cam.rotation.x, cam.rotation.y, cam.rotation.z),
                    });
                }
            }
        });

        this.add(this._scene);
        this.add(this._light);
        this.add(new PointLightHelper(this._light, 1));
        this.add(this._mirror);
        this._lenis = new Lenis({
            duration: 1.2, // Durée de l’inertie (plus haut = plus smooth)
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Courbe de transition
            smoothWheel: true, // Active le scroll fluide avec la molette
            gestureOrientation: "vertical", // Scroll vertical uniquement (empêche les bugs)
        });

        // Écoute les mises à jour de Lenis
        this._lenis.on('scroll', ({ progress }) => {
            this.setScrollProgress(progress);
        });
        this.animate();
    }
    private animate() {
        this._lenis.raf(performance.now());
        requestAnimationFrame(() => this.animate());
    }
    public setScrollProgress(progress: number) {
        if (this._pauseScrollProgress !== null) {
            if (Math.abs(progress - this._pauseScrollProgress) > this._scrollResumeThreshold) {
                this._scrollProgress = this._pauseScrollProgress + Math.sign(progress - this._pauseScrollProgress) * this._scrollResumeThreshold;
                this._pauseScrollProgress = null;
            } else {
                return;
            }
        }

        // 🎯 Appliquer un lissage sur le scroll pour ralentir le mouvement
        gsap.to(this, {
            _scrollProgress: progress, // Valeur cible
            duration: 0.2, // Temps d'adaptation (augmente pour ralentir plus)
            ease: "power2.out" // Courbe d’accélération/décélération
        });
    }

    public getCameraPositions() {
        return this._cameraPositions;
    }
    private _scrollSpeedFactor: number = 3;

    public override update(dt: number): void {
        super.update(dt);
        this._lenis.raf(performance.now());

        if (this._light.decay > 2) this._light.decay -= 0.02;
        if (this._light.distance < 100) this._light.distance += 0.1;
        if (this._cameraPositions.length < 2) return;

        const index = Math.floor(this._scrollProgress * (this._cameraPositions.length - 1));
        const nextIndex = Math.min(index + 1, this._cameraPositions.length - 1);
        const lerpFactor = (this._scrollProgress * (this._cameraPositions.length - 1)) % 1;

        // 🎯 **Détection de breakpoint**
        if (lerpFactor < this._pauseThreshold && this._pauseScrollProgress === null) {
            this._pauseScrollProgress = this._scrollProgress; // 🔹 Stocke la position actuelle pour pause
        }

        // Si on est en pause, la caméra est **fixée** au point
        if (this._pauseScrollProgress !== null) {
            return;
        }

        const start = this._cameraPositions[index];
        const end = this._cameraPositions[nextIndex];

        if (start && end) {
            gsap.to(this._camera.position, {
                x: start.position.x * (1 - lerpFactor) + end.position.x * lerpFactor,
                y: start.position.y * (1 - lerpFactor) + end.position.y * lerpFactor,
                z: start.position.z * (1 - lerpFactor) + end.position.z * lerpFactor,
                duration: 0.5,
                ease: "power2.out",
            });

            gsap.to(this._camera.rotation, {
                y: start.rotation.y * (1 - lerpFactor) + end.rotation.y * lerpFactor,
                duration: 0.5,
                ease: "power2.out",
            });
        }
    }
}







import React, { useEffect, useState } from "react";
import ReactViewBase, { TransitionProps } from "../../../core/_engine/reacts/views/bases/ReactViewBase";
import { ViewId } from "../../../constants/views/ViewId";
import { ViewsProxy } from "pancake";
import gsap from "gsap";

const breakpoints = [
    { title: "Bienvenue", description: "Découvrez notre univers immersif." },
    { title: "Galerie", description: "Une sélection de nos meilleures œuvres." },
    { title: "Expérience Interactive", description: "Interagissez avec notre monde en 3D." },
    { title: "Contact", description: "Restons en contact pour de nouvelles aventures !" },
    { title: "Galerie", description: "Une sélection de nos meilleures œuvres." },
    { title: "Expérience Interactive", description: "Interagissez avec notre monde en 3D." },


];

const MainReactView: React.FC<TransitionProps> = (props) => {
    const [scrollProgress, setScrollProgress] = useState(0);
    const [activeIndex, setActiveIndex] = useState(0);
    const [fadeOpacity, setFadeOpacity] = useState(1);
    const [prevScroll, setPrevScroll] = useState(0); // 🔹 Stocke la position précédente pour détecter la direction

    useEffect(() => {
        const onScroll = () => {
            const scrollY = window.scrollY;
            const maxScroll = document.body.scrollHeight - window.innerHeight;
            const progress = maxScroll > 0 ? scrollY / maxScroll : 0;
            setScrollProgress(progress);
        };

        window.addEventListener("scroll", onScroll);
        return () => window.removeEventListener("scroll", onScroll);
    }, []);

    useEffect(() => {
        const mainView = ViewsProxy.GetView(ViewId.THREE_MAIN) as any;
        if (mainView && mainView.setScrollProgress) {
            mainView.setScrollProgress(scrollProgress);
        }

        const numBreakpoints = breakpoints.length;
        const sectionSize = 1 / numBreakpoints;
        const newIndex = Math.min(Math.floor(scrollProgress / sectionSize), numBreakpoints - 1);
        const sectionProgress = (scrollProgress - newIndex * sectionSize) / sectionSize;

        const isScrollingDown = scrollProgress > prevScroll; // 🔹 Vérifie la direction du scroll

        if (newIndex !== activeIndex) {
            setActiveIndex(newIndex);
            gsap.to(".breakpoint-content", { opacity: 1, duration: 0.2, ease: "power2.out" });
        }

        // 🔹 Appliquer un fade out seulement en descendant (évite le bug en scroll up)
        if (isScrollingDown) {
            const fadeOutProgress = Math.min(Math.max((sectionProgress - 0.5) * 2, 0), 1);
            setFadeOpacity(1 - fadeOutProgress);

            gsap.to(".breakpoint-content", {
                opacity: fadeOpacity,
                duration: 0.3,
                ease: "power2.out"
            });
        }

        setPrevScroll(scrollProgress); // 🔹 Mise à jour de la position précédente
    }, [scrollProgress, activeIndex, fadeOpacity]);

    return (
        <ReactViewBase {...props} className="w-screen h-[800dvh] z-50 relative flex flex-col justify-center items-center">
            <div
                className="fixed top-1/3 left-1/2 -translate-x-1/2 text-center text-white breakpoint-content"
                style={{ opacity: fadeOpacity }}
            >
                <h1 className="text-4xl font-bold">{breakpoints[activeIndex].title}</h1>
                <p className="text-lg mt-2">{breakpoints[activeIndex].description}</p>
            </div>
        </ReactViewBase>
    );
};

export default MainReactView;